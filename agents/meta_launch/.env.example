# Copy this file to `.env` and fill in. `.env` is gitignored — the token never gets committed.
#
# This script WRITES to the ad account, so it needs an `ads_management` token.
# The read-only `ads_read` token used by ../meta_audit is not sufficient.
#
# Prefer a System User token from Business Settings over a personal one: it isn't
# tied to an individual's login and can be revoked without breaking anything else.

META_ACCESS_TOKEN=PASTE_YOUR_ADS_MANAGEMENT_TOKEN_HERE
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXX
# Optional — defaults to a recent Graph API version. Bump if Meta says the version is unsupported.
GRAPH_API_VERSION=v23.0
