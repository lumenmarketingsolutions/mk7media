# Copy this file to `.env` and fill in. `.env` is gitignored — the token never gets committed.
# Use a read-only token (ads_read scope) for the audit.

META_ACCESS_TOKEN=PASTE_YOUR_ADS_READ_TOKEN_HERE
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXX
# Optional — defaults to a recent Graph API version. Bump if Meta says the version is unsupported.
GRAPH_API_VERSION=v23.0
